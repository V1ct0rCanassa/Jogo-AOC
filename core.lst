     1                                  ; =====================================================================
     2                                  ; main.asm  ·  PESSOA 2 — MOTOR E FLUXO DO JOGO
     3                                  ;
     4                                  ;   - Início/saída, loop principal, relógio da BIOS, teclado (int 16h), som (PIT)
     5                                  ;   - Máquina de estados: tick, on_key e as teclas de cada estado (key_tab)
     6                                  ;   - Economia: pontos, ganhos, desbloqueio de torres; mensagens (toast)
     7                                  ;   - Fluxo: new_game, preparação, onda (wave_tick chama os módulos), fim, chefe
     8                                  ;   - Monta o jogo inteiro: inclui os outros três arquivos, os dados e as variáveis
     9                                  ;
    10                                  ; Arquivos do jogo e donos:
    11                                  ;   main.asm          Pessoa 2  motor e fluxo (este arquivo; monta tudo)
    12                                  ;   defs.inc          Pessoa 2  constantes, structs e macros comuns
    13                                  ;   graficos.asm      Pessoa 1  vídeo, desenho e telas
    14                                  ;   inimigos.asm      Pessoa 3  inimigos, ondas e chefes
    15                                  ;   torres_mapas.asm  Pessoa 4  torres, combate e elementos do mapa
    16                                  ;   data.inc          gerado por gen_data.py (arte, fases, ondas, chefes)
    17                                  ;
    18                                  ; Parte do Core Defense x86. Montado junto pelo main.asm:
    19                                  ;   nasm -f bin main.asm -o CORE.COM
    20                                  ; =====================================================================
    21                                  
    22                                  cpu 386
    23                                  org 100h
    24                                  
    25                                  %include "defs.inc"
     1                              <1> ; =====================================================================
     2                              <1> ; defs.inc  ·  CONSTANTES E CONTRATOS COMUNS (dono: Pessoa 2)
     3                              <1> ;
     4                              <1> ;   Structs (inimigo 16 bytes, torre 8 bytes), registro da fase e do chefe,
     5                              <1> ;   estados, bits das regras e as macros de desenho da Pessoa 1.
     6                              <1> ;   Mudou algo aqui? Avise os outros três antes de subir.
     7                              <1> ; =====================================================================
     8                              <1> 
     9                              <1> ; =====================================================================
    10                              <1> ;  CORE DEFENSE  -  versão x86 (DOS, modo real 16 bits, NASM)
    11                              <1> ;  Montar:  nasm -f bin main.asm -o CORE.COM   (main.asm inclui os outros)
    12                              <1> ;  Rodar:   DOSBox (cycles=max)  ->  CORE
    13                              <1> ;
    14                              <1> ;  Vídeo: VGA modo 13h reprogramado para 320x120 (timing de 480 linhas,
    15                              <1> ;  cada linha repetida 4x). O jogo desenha num back buffer 160x120 e o
    16                              <1> ;  blit duplica cada pixel na horizontal. Lógica a 18,2 quadros/s (tick
    17                              <1> ;  da BIOS), teclado pela int 16h, som pelo alto-falante (PIT canal 2).
    18                              <1> ; =====================================================================
    19                              <1> bits 16
    20                              <1> 
    21                              <1> W       equ 160
    22                              <1> H       equ 120
    23                              <1> MAXE    equ 64              ; inimigos simultâneos
    24                              <1> ESZ     equ 16              ; bytes por inimigo
    25                              <1> MAXT    equ 10              ; soquetes (torres)
    26                              <1> TSZ     equ 8
    27                              <1> MAXFX   equ 24
    28                              <1> FXSZ    equ 8
    29                              <1> MAXP    equ 48
    30                              <1> PSZ     equ 8
    31                              <1> BGOFF   equ 5000h           ; mapa descompactado no segmento do back buffer
    32                              <1> PREPT   equ 364             ; 20 s de preparação
    33                              <1> ABT     equ 100             ; duração das habilidades (ticks)
    34                              <1> 
    35                              <1> ; ---- struct inimigo ----
    36                              <1> E_ACT   equ 0
    37                              <1> E_TYPE  equ 1               ; 0 bug 1 virus 2 trojan 3 worm 4 ransom 5 rootkit
    38                              <1> E_ROUTE equ 2
    39                              <1> E_FLAGS equ 3               ; 1 escudo 2 passou EX 4 travou torre 8 segurado
    40                              <1> E_D     equ 4               ; distância na rota (1/16 px)
    41                              <1> E_HP    equ 6
    42                              <1> E_MAX   equ 8
    43                              <1> E_SPD   equ 10
    44                              <1> E_SLOW  equ 11
    45                              <1> E_STOP  equ 12
    46                              <1> E_FLASH equ 13
    47                              <1> E_X     equ 14
    48                              <1> E_Y     equ 15
    49                              <1> ; ---- struct torre (por soquete) ----
    50                              <1> T_TYPE  equ 0               ; 0 vazio, 1..4
    51                              <1> T_LVL   equ 1
    52                              <1> T_CD    equ 2               ; recarga em 1/4 de tick
    53                              <1> T_LOCK  equ 3
    54                              <1> T_INV   equ 4               ; word: pontos investidos
    55                              <1> T_FLASH equ 6
    56                              <1> T_USE   equ 7               ; desgaste (SSD)
    57                              <1> ; ---- registro de fase (gerado em data.inc) ----
    58                              <1> P_NAME  equ 0
    59                              <1> P_TITLE equ 2
    60                              <1> P_INTRO equ 4
    61                              <1> P_REGRA equ 10
    62                              <1> P_BAND  equ 16
    63                              <1> P_FLAGS equ 17
    64                              <1> P_COREX equ 18
    65                              <1> P_COREY equ 19
    66                              <1> P_CSPR  equ 20
    67                              <1> P_ICON  equ 22
    68                              <1> P_NSLOT equ 24
    69                              <1> P_NROUT equ 25
    70                              <1> P_SLOTS equ 26
    71                              <1> P_ROUTS equ 28
    72                              <1> P_INIT  equ 30
    73                              <1> P_OPENW equ 31
    74                              <1> P_OPENM equ 32
    75                              <1> P_OMSG  equ 34
    76                              <1> P_START equ 36
    77                              <1> P_CAP   equ 38
    78                              <1> P_NTOW  equ 40
    79                              <1> P_ABIL  equ 41
    80                              <1> P_TOWT  equ 42
    81                              <1> P_TOWN  equ 46
    82                              <1> P_NWAV  equ 54
    83                              <1> P_WORM  equ 55
    84                              <1> P_WAVES equ 56
    85                              <1> P_ESPD  equ 58
    86                              <1> P_EDMG  equ 64
    87                              <1> P_EPTS  equ 70
    88                              <1> P_HP    equ 82
    89                              <1> P_MAP   equ 84
    90                              <1> F_CAP   equ 1
    91                              <1> F_HEAD  equ 2
    92                              <1> F_WEAR  equ 4
    93                              <1> F_RAND  equ 8
    94                              <1> F_HEAT  equ 16
    95                              <1> F_AREA  equ 32
    96                              <1> F_PIPE  equ 64
    97                              <1> ; ---- estados ----
    98                              <1> ST_MENU equ 0
    99                              <1> ST_CTRL equ 1
   100                              <1> ST_SEL  equ 2
   101                              <1> ST_INTRO equ 3
   102                              <1> ST_PREP equ 4
   103                              <1> ST_WAVE equ 5
   104                              <1> ST_AVISO equ 6
   105                              <1> ST_WEND equ 7
   106                              <1> ST_OVER equ 8
   107                              <1> ST_WIN  equ 9
   108                              <1> ST_BOSS equ 10              ; alerta de chefe antes da última preparação
   109                              <1> ET_BOSS equ 6               ; tipo de inimigo do chefe
   110                              <1> ; registro EXT (elemento do mapa + chefe), um por fase, gerado em data.inc
   111                              <1> X_ELN   equ 0               ; nome do elemento
   112                              <1> X_TXT   equ 2               ; 3 linhas de explicação
   113                              <1> X_BOX   equ 8               ; caixa do elemento em tiles: x0,y0,x1,y1 (255 = sem caixa)
   114                              <1> X_BOX2  equ 12
   115                              <1> X_CHG   equ 16              ; quadros para carregar
   116                              <1> X_HINT  equ 18
   117                              <1> X_BN    equ 20              ; nome do chefe
   118                              <1> X_BD    equ 22              ; 3 linhas sobre o chefe
   119                              <1> X_BHP   equ 28
   120                              <1> X_BSPD  equ 30
   121                              <1> X_BDMG  equ 31
   122                              <1> X_BPTS  equ 32
   123                              <1> X_EVERY equ 34              ; chama reforços a cada N quadros
   124                              <1> X_CALL  equ 35
   125                              <1> X_NCALL equ 36
   126                              <1> X_DRAIN equ 37              ; tira 1 ponto a cada N quadros
   127                              <1> X_BFL   equ 38
   128                              <1> X_LOCK  equ 39              ; trava torres a cada N quadros
   129                              <1> X_JUMP  equ 40              ; troca de porta a cada N quadros
   130                              <1> X_SHLD  equ 41              ; escudo volta a cada N quadros
   131                              <1> X_HALF  equ 42              ; tipo chamado com meia vida (255 = nenhum)
   132                              <1> X_NHALF equ 43
   133                              <1> X_BRT   equ 44
   134                              <1> X_SPLIT equ 45              ; worms ao morrer
   135                              <1> X_BWAV  equ 46              ; grupos da onda do chefe
   136                              <1> X_BSPR  equ 48
   137                              <1> X_BSPR2 equ 50
   138                              <1> X_KEYS  equ 52              ; teclas do teclado (0 = elemento com caixa)
   139                              <1> BF_ARMOR equ 1
   140                              <1> BF_ENR   equ 2
   141                              <1> BF_NOEX  equ 4
   142                              <1> BF_NOSLOW equ 8
   143                              <1> BF_HEAT  equ 16
