   145                              <1> ; ---------------------------------------------------------------------
   146                              <1> ; macros de desenho (argumentos imediatos ou registradores)
   147                              <1> %macro RECT 5            ; x,y,w,h,cor
   148                              <1>     mov ax,%1
   149                              <1>     mov bx,%2
   150                              <1>     mov cx,%3
   151                              <1>     mov dx,%4
   152                              <1>     mov si,%5
   153                              <1>     call fillrect
   154                              <1> %endmacro
   155                              <1> %macro FRAME 5
   156                              <1>     mov ax,%1
   157                              <1>     mov bx,%2
   158                              <1>     mov cx,%3
   159                              <1>     mov dx,%4
   160                              <1>     mov si,%5
   161                              <1>     call frame
   162                              <1> %endmacro
   163                              <1> %macro TEXT 5            ; str,x,y,cor,escala
   164                              <1>     mov si,%1
   165                              <1>     mov ax,%2
   166                              <1>     mov bx,%3
   167                              <1>     mov cl,%4
   168                              <1>     mov ch,%5
   169                              <1>     call drawtext
   170                              <1> %endmacro
   171                              <1> %macro CTEXT 6           ; str,y,cor,escala,x0,w
   172                              <1>     mov si,%1
   173                              <1>     mov bx,%2
   174                              <1>     mov cl,%3
   175                              <1>     mov ch,%4
   176                              <1>     mov dx,%5
   177                              <1>     mov di,%6
   178                              <1>     call ctext
   179                              <1> %endmacro
   180                              <1> %macro SPR 3             ; sprite,x,y
   181                              <1>     mov si,%1
   182                              <1>     mov ax,%2
   183                              <1>     mov bx,%3
   184                              <1>     call drawspr
   185                              <1> %endmacro
